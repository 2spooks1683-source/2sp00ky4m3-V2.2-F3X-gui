local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SpookyGuiV2"
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 800, 0, 450)
MainFrame.Position = UDim2.new(0.5, -400, 0.5, -225)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MainFrame.BorderSizePixel = 3
MainFrame.BorderColor3 = Color3.fromRGB(255, 69, 0) -- Turuncu çizgiler
MainFrame.Parent = ScreenGui

local function createHeader(text, x, y, width, height)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, width, 0, height)
    label.Position = UDim2.new(0, x, 0, y)
    label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Text = text
    label.TextSize = 16
    label.Font = Enum.Font.SourceSansBold
    label.BorderColor3 = Color3.fromRGB(255, 69, 0)
    label.Parent = MainFrame
    return label
end

createHeader("2sp00ky4m3 Gui V2.2    F3X", 5, 5, 390, 40)
createHeader("Settings (Some are merely decorative)", 400, 5, 395, 40)

createHeader("Server Destruction", 5, 50, 190, 30)
createHeader("Admin Guis/Musics", 200, 50, 195, 30)
createHeader("Skybox/Decal ID", 400, 50, 195, 30)
createHeader("Particle ID", 600, 50, 195, 30)

_G.Buttons = {}
local function createButton(name, text, x, y, w, h, isOrange)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, w, 0, h)
    btn.Position = UDim2.new(0, x, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.TextColor3 = isOrange and Color3.fromRGB(255, 69, 0) or Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSans
    btn.BorderColor3 = Color3.fromRGB(255, 69, 0)
    btn.Parent = MainFrame
    _G.Buttons[name] = btn
    return btn
end

_G.Inputs = {}
local function createTextBox(name, placeholder, x, y, w, h)
    local box = Instance.new("TextBox")
    box.Name = name
    box.Size = UDim2.new(0, w, 0, h)
    box.Position = UDim2.new(0, x, 0, y)
    box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Text = placeholder
    box.TextSize = 14
    box.Font = Enum.Font.SourceSans
    box.BorderColor3 = Color3.fromRGB(255, 69, 0)
    box.ClearTextOnFocus = false
    box.Parent = MainFrame
    _G.Inputs[name] = box
    return box
end

local CreateBaseplateBtn = createButton("CreateBaseplate", "Create Baseplate", 5, 85, 90, 40)
CreateBaseplateBtn.MouseButton1Click:Connect(function()
local player = game.Players.LocalPlayer
local char = player.Character
local tool

for i, v in player:GetDescendants() do
	if v.Name == "SyncAPI" then
		tool = v.Parent
	end
end

for i, v in game.ReplicatedStorage:GetDescendants() do
	if v.Name == "SyncAPI" then
		tool = v.Parent
	end
end

local remote = tool.SyncAPI.ServerEndpoint

local function _(args)
	remote:InvokeServer(unpack(args))
end

local function CreatePart(cf, parent, types)
	local args = {
		[1] = "CreatePart",
		[2] = types,
		[3] = cf,
		[4] = parent
	}
	_(args)
end

local function Resize(part, size, cf)
	local args = {
		[1] = "SyncResize",
		[2] = {
			[1] = {
				["Part"] = part,
				["CFrame"] = cf,
				["Size"] = size
			}
		}
	}
	_(args)
end

local function Material(part, mate)
	local args = {
		[1] = "SyncMaterial",
		[2] = {
			[1] = {
				["Part"] = part,
				["Material"] = mate
			}
		}
	}
	_(args)
end

local function Color(part, color)
	local args = {
		[1] = "SyncColor",
		[2] = {
			[1] = {
				["Part"] = part,
				["Color"] = color,
				["UnionColoring"] = false
			}
		}
	}
	_(args)
end

local function SetLocked(part, boolean)
	local args = {
		[1] = "SetLocked",
		[2] = {
			[1] = part
		},
		[3] = boolean
	}
	_(args)
end

local hrpx = math.floor(char.HumanoidRootPart.CFrame.x)
local hrpz = math.floor(char.HumanoidRootPart.CFrame.z)
local hrpy = math.floor(char.HumanoidRootPart.CFrame.y)

local function SpawnBasePlate()
	CreatePart(CFrame.new(hrpx, hrpy - 20, hrpz), workspace, "Spawn")
	for i, v in game.Workspace:GetChildren() do
		if v:IsA("BasePart") and v.CFrame.y == hrpy - 20 and v.CFrame.x == hrpx then
			task.spawn(function()
				Resize(v, Vector3.new(1000, 2, 1000), CFrame.new(hrpx, hrpy - 20, hrpz))
				Material(v, Enum.Material.Grass)
				Color(v, Color3.fromRGB(25, 100, 25))
				while task.wait(1) do
					pcall(function() SetLocked(v, true) end)
				end
			end)
		end
	end
end

SpawnBasePlate()

end)

local SetSkyboxBtn = createButton("SetSkybox", "Set Skybox", 100, 85, 95, 40)
