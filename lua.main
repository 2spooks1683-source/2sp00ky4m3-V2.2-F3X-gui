	local args = {
		[1] = "SyncColor",
		[2] = {
			[1] = {
				["Part"] = part,
				["Color"] = color,
				["UnionColoring"] = false
			}
		}
	}
	_(args)
end

local function ColorAll()
	spawn(function()
		while true do
			local randomColor = Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255))
			for i, v in game.Workspace:GetDescendants() do
				if v:IsA("BasePart") then
					spawn(function()
