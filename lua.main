_G.Buttons = {}
local function createButton(name, text, x, y, w, h, isOrange)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, w, 0, h)
    btn.Position = UDim2.new(0, x, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.TextColor3 = isOrange and Color3.fromRGB(255, 69, 0) or Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSans
    btn.BorderColor3 = Color3.fromRGB(255, 69, 0)
    btn.Parent = MainFrame
    _G.Buttons[name] = btn
    return btn
end

_G.Inputs = {}
local function createTextBox(name, placeholder, x, y, w, h)
    local box = Instance.new("TextBox")
    box.Name = name
    box.Size = UDim2.new(0, w, 0, h)
    box.Position = UDim2.new(0, x, 0, y)
    box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Text = placeholder
    box.TextSize = 14
    box.Font = Enum.Font.SourceSans
    box.BorderColor3 = Color3.fromRGB(255, 69, 0)
    box.ClearTextOnFocus = false
    box.Parent = MainFrame
    _G.Inputs[name] = box
    return box
end

